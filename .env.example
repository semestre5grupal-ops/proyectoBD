# ==========================================
# Archivo de Ejemplo de Variables de Entorno
# ==========================================
# Instrucciones para el equipo:
# 1. Copien este archivo y renómbrenlo a '.env' dentro de su respectivo API.
# 2. Reemplacen los valores con sus credenciales locales.
# IMPORTANTE: ¡Nunca suban el archivo '.env' real al repositorio (Git lo ignorará automáticamente)!

# ==========================================
# Configuración del Servidor
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# Configuración de Base de Datos
# ==========================================
# Ejemplo si usan MongoDB:
DB_URI=mongodb://localhost:27017/nombre_de_tu_api_db

# Ejemplo si usan bases relacionales (MySQL/PostgreSQL):
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_contraseña_local
DB_NAME=nombre_de_tu_api_db
DB_PORT=5432

# ==========================================
# Configuración de Seguridad (Tokens)
# ==========================================
JWT_SECRET=super_secreto_para_desarrollo_local_123
JWT_EXPIRES_IN=1d

# ==========================================
# URLs de Integración (Comunicación Local Inter-APIs)
# ==========================================
# Si el API de Ventas necesita hablar con Inventario en local, usaría estas URLs:
URL_API_TALENTO_HUMANO=http://localhost:3001
URL_API_COMPRAS=http://localhost:3002
URL_API_VENTAS=http://localhost:3003
URL_API_INVENTARIO=http://localhost:3004
