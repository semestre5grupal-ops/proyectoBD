# ==========================================
# API Ventas - Variables de Entorno
# ==========================================

# Servidor
PORT=3003
NODE_ENV=development

# ==========================================
# Supabase - Base de Datos de Ventas
# ==========================================
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_KEY=<service_role_key>

# ==========================================
# Seguridad JWT (debe ser idéntica a api-talento-humano e api-inventario)
# ==========================================
JWT_SECRET=super_secreto_para_desarrollo_local_123
JWT_EXPIRES_IN=1d

# ==========================================
# Integración con API Inventario
# INVENTARIO_API_URL: URL base del servicio de inventario.
# Fallback: URL_API_INVENTARIO (nombre anterior, conservado para compatibilidad).
# ==========================================
INVENTARIO_API_URL=https://api-inventario-1r1w.onrender.com
# URL_API_INVENTARIO=http://localhost:3004  # desarrollo local alternativo

# Timeout HTTP para llamadas a Inventario (ms)
HTTP_TIMEOUT_MS=5000

# ==========================================
# Parámetros de negocio
# ==========================================
# Tasa de IVA (fracción decimal). Ejemplo: 0.15 = 15 %
TASA_IVA=0.15

# Período por defecto para metas de vendedor.
# TODO[OI-06]: confirmar si viene de api-talento-humano.
PERIODO_METAS=MENSUAL
